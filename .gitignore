Manifest.toml
.vscode/**

# Serialised ROMs: 8.6 MB for one order-9 parametrisation, and regenerated by
# every run. Large binaries belong in the MORFE_results_archive repository.
# The small text outputs under results/ stay tracked, because they are what the
# READMEs quote and what the website's figures are built from.
*/results/data/*.jls

# macOS directory metadata
.DS_Store
*/.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/
